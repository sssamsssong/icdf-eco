# Jetson이 켜지면 agent.py를 자동으로 실행합니다.
# 설치 (Jetson에서, 저장소를 ~/icdf-eco에 받았다고 가정. 사용자 이름이 다르면 User와 경로를 고치세요):
#   sudo cp ~/icdf-eco/jetson/icdf-agent.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now icdf-agent
# 상태와 로그:
#   systemctl status icdf-agent
#   journalctl -u icdf-agent -f
[Unit]
Description=ICDF_eco Jetson agent (AI job + power report)
After=network-online.target
Wants=network-online.target

[Service]
User=jetson
WorkingDirectory=/home/jetson/icdf-eco/jetson
# 부팅 직후에는 다른 서비스 때문에 전력이 높아서, 바로 켜면 대기 전력이 높게 잡힙니다 (실측 6.5 W vs 평소 4~4.5 W).
# 1분 기다렸다가 켜서 대기 전력을 제대로 잽니다. 재시작(Restart=always) 때도 1분 기다립니다.
ExecStartPre=/bin/sleep 60
TimeoutStartSec=90
ExecStart=/usr/bin/python3 -u agent.py --port 8100 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
